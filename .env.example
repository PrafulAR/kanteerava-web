# Reference values are split into backend/.env and frontend/.env when running
# locally. Never commit either real .env file.
SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=scout_group
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_X_FORWARDED_PROTO=False

# Backend-only Cloudinary media configuration. CLOUDINARY_API_SECRET is a
# secret and must never be exposed through a VITE_ variable.
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_FROM_EMAIL=replace-with-your-verified-sender@example.com
BREVO_FROM_NAME=XV Kanteerava
BREVO_API_TIMEOUT_SECONDS=10
GOOGLE_OAUTH_CLIENT_ID=replace-with-your-web-client-id.apps.googleusercontent.com

VITE_API_URL=http://localhost:8000/api
VITE_GOOGLE_CLIENT_ID=replace-with-your-web-client-id.apps.googleusercontent.com
