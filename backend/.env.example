SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=scout_group
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Set True only on Render (or another trusted proxy) that controls
# X-Forwarded-Proto. Keep False for direct/local Django access.
TRUST_X_FORWARDED_PROTO=False

# Uploaded media. Local development uses FileSystemStorage by default.
# For production Cloudinary, set USE_CLOUDINARY=True and configure the three
# backend-only values below. CLOUDINARY_API_SECRET is a secret.
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Verification and password-reset delivery through the Brevo HTTPS API.
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_FROM_EMAIL=replace-with-your-verified-sender@example.com
BREVO_FROM_NAME=XV Kanteerava
BREVO_API_TIMEOUT_SECONDS=10

AUTH_OTP_EXPIRY_MINUTES=10
AUTH_OTP_RESEND_COOLDOWN_SECONDS=45
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_SENDS=5
AUTH_PASSWORD_RESET_GRANT_MINUTES=10

# Public OAuth client ID created for Google Identity Services. Do not put a
# Google client secret in the frontend.
GOOGLE_OAUTH_CLIENT_ID=replace-with-your-web-client-id.apps.googleusercontent.com
